<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mobile_color_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/firebase_upload_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/mobile_dialog_back"
                android:padding="12dp"
                android:src="@drawable/ic_mobile_back_arrow" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/firebase_upload_title"
                android:textColor="@color/mobile_color_on_surface"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <EditText
            android:id="@+id/firebase_upload_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/mobile_you_tile_bg"
            android:hint="@string/firebase_video_title_hint"
            android:inputType="textCapSentences"
            android:padding="14dp"
            android:textColor="@color/mobile_color_on_surface"
            android:textColorHint="@color/mobile_color_on_surface_secondary" />

        <EditText
            android:id="@+id/firebase_upload_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/mobile_you_tile_bg"
            android:gravity="top|start"
            android:hint="@string/firebase_video_description_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:minHeight="96dp"
            android:padding="14dp"
            android:textColor="@color/mobile_color_on_surface"
            android:textColorHint="@color/mobile_color_on_surface_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/firebase_pick_video"
            style="@style/Widget.NewTube.Button.Pill"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:text="@string/firebase_select_video"
            android:textAllCaps="false"
            app:cornerRadius="26dp" />

        <TextView
            android:id="@+id/firebase_upload_video_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingTop="6dp"
            android:textColor="@color/mobile_color_on_surface_secondary"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/firebase_pick_thumbnail"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="@string/firebase_select_thumbnail"
            android:textAllCaps="false"
            app:cornerRadius="26dp" />

        <TextView
            android:id="@+id/firebase_upload_thumbnail_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingTop="6dp"
            android:textColor="@color/mobile_color_on_surface_secondary"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/firebase_upload_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/firebase_upload_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:textColor="@color/mobile_color_on_surface_secondary"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/firebase_upload_publish"
            style="@style/Widget.NewTube.Button.Pill"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:enabled="false"
            android:text="@string/firebase_publish_video"
            android:textAllCaps="false"
            app:cornerRadius="26dp" />

    </LinearLayout>
</ScrollView>
